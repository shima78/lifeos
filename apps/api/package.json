{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts prisma",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand -c test/jest-e2e.config.js",
    "smoke": "ts-node scripts/smoke-context.ts",
    "mcp": "node dist/mcp.js",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed && pnpm db:seed",
    "db:backup": "dotenv -e ../../.env -- ts-node scripts/db-backup.ts",
    "db:restore": "dotenv -e ../../.env -- ts-node scripts/db-restore.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@lifeos/contracts": "workspace:^",
    "@modelcontextprotocol/sdk": "1",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "@prisma/client": "6",
    "dotenv": "17",
    "reflect-metadata": "0.2",
    "rxjs": "7",
    "zod": "3"
  },
  "devDependencies": {
    "@nestjs/cli": "11",
    "@nestjs/schematics": "11",
    "@nestjs/testing": "11",
    "@types/express": "5",
    "@types/jest": "29",
    "@types/node": "22",
    "@types/supertest": "6",
    "dotenv-cli": "8",
    "jest": "29",
    "prisma": "6",
    "supertest": "7",
    "ts-jest": "29",
    "ts-node": "10",
    "typescript": "5"
  }
}
