# Copied to .env automatically on `pnpm install` if .env does not exist.
# No API keys are needed (or used) anywhere in LifeOS.

# Postgres: `pnpm dev` / `pnpm db:start` runs a local server with these settings (data in
# ~/.lifeos/postgres, or $LIFEOS_HOME/postgres), or use `docker compose up -d`.
DATABASE_URL=postgresql://lifeos:lifeos@localhost:5432/lifeos?schema=public
# Separate database for `pnpm test` and `pnpm test:e2e` (same server)
TEST_DATABASE_URL=postgresql://lifeos:lifeos@localhost:5432/lifeos_test?schema=public

# Where local data (database, backups) lives. Default: ~/.lifeos
# LIFEOS_HOME=

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Web (keep WEB_ORIGIN above in sync with PORT)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Assistant: path to the Claude Code CLI if `claude` is not on PATH
# CLAUDE_BIN=

# Daily application goal shown on the dashboard (applications per day)
APPLICATION_GOAL_PER_DAY=3
